# Hotel Management System — Local and production environment template
# Copy to `.env` in the backend folder and fill in the real values.

# Server Configuration
PORT=3000
NODE_ENV=development
QR_SECRET_SALT=replace-with-a-cryptographically-secure-random-string

# Supabase Configuration
# Fill in your Supabase Project URL and API keys from the Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend Origin whitelist for strict CORS in production.
# For local development, leave this unset and the app will accept localhost.
FRONTEND_URL=https://your-customer-frontend.vercel.app,https://your-staff-frontend.vercel.app

# Optional payment configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
KBZPAY_APP_ID=your-kbzpay-app-id
KBZPAY_MERCH_CODE=your-kbzpay-merchant-code
KBZPAY_MERCHANT_KEY=your-kbzpay-merchant-key

# Rate limits (optional overrides)
GLOBAL_RATE_LIMIT=100
STRICT_RATE_LIMIT=10
