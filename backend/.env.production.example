# ============================================================================
# Hotel Management System — Production Environment Configuration Template
# Copy this file to `.env.production` on your production server and fill in secrets.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend Origin for Strict CORS Whitelisting
# Use the exact production domains for the Vercel customer and staff apps.
FRONTEND_URL=https://stayease-customer.vercel.app,https://stayease-staff.vercel.app

# Cryptographic QR Token Salt
QR_SECRET_SALT=replace-with-a-cryptographically-secure-random-string

# Supabase Production PostgreSQL & API Credentials
# Retrieve from: Supabase Dashboard -> Settings -> API & Database
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Payment Gateway: Visa / Stripe (Production)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Payment Gateway: KBZPay (Production)
KBZPAY_APP_ID=your-kbzpay-app-id
KBZPAY_MERCH_CODE=your-kbzpay-merchant-code
KBZPAY_MERCHANT_KEY=your-kbzpay-production-merchant-secret-key

# Tiered Rate Limiting Configurations (Optional overrides)
GLOBAL_RATE_LIMIT=100
STRICT_RATE_LIMIT=10
